import java.util.*;

// ---------------------- SERVICE REGISTRY ----------------------
class ServiceRegistry {

    private static Map<String, List<String>> registry = new HashMap<>();
    private static Map<String, Integer> counter = new HashMap<>();

    // Register service instances
    public static void register(String serviceName, String instance) {
        registry.computeIfAbsent(serviceName, k -> new ArrayList<>()).add(instance);
        counter.put(serviceName, 0);
    }

    // Load Balancing (Round Robin)
    public static String getInstance(String serviceName) {
        List<String> instances = registry.get(serviceName);

        if (instances == null || instances.isEmpty()) return null;

        int index = counter.get(serviceName);
        String instance = instances.get(index);

        counter.put(serviceName, (index + 1) % instances.size());

        return instance;
    }
}

// ---------------------- USER SERVICE ----------------------
class UserService {

    private String instance;

    public UserService(String instance) {
        this.instance = instance;
        ServiceRegistry.register("USER-SERVICE", instance);
    }

    public String getUser(int id) {
        return instance + " -> User-" + id;
    }
}

// ---------------------- ORDER SERVICE ----------------------
class OrderService {

    private String instance;

    public OrderService(String instance) {
        this.instance = instance;
        ServiceRegistry.register("ORDER-SERVICE", instance);
    }

    public String placeOrder(int userId, String product) {

        // Discover USER SERVICE dynamically
        String userInstance = ServiceRegistry.getInstance("USER-SERVICE");

        if (userInstance == null) return "User Service unavailable";

        String user = userInstance + " -> User-" + userId;

        return instance + " processed order: " + user + " bought " + product;
    }
}

// ---------------------- API GATEWAY ----------------------
class ApiGateway {

    public String handleRequest(String url) {

        // Routing logic
        if (url.startsWith("/user")) {
            int id = Integer.parseInt(url.split("/")[2]);

            String instance = ServiceRegistry.getInstance("USER-SERVICE");
            if (instance == null) return "User Service unavailable";

            UserService us = new UserService(instance);
            return us.getUser(id);
        }

        if (url.startsWith("/order")) {
            String[] parts = url.split("/");
            int userId = Integer.parseInt(parts[2]);
            String product = parts[3];

            String instance = ServiceRegistry.getInstance("ORDER-SERVICE");
            if (instance == null) return "Order Service unavailable";

            OrderService os = new OrderService(instance);
            return os.placeOrder(userId, product);
        }

        return "Invalid route";
    }
}

// ---------------------- MAIN ----------------------
public class Task16_ApiGatewayDemo {

    public static void main(String[] args) {

        // Register multiple instances
        new UserService("User-Instance1");
        new UserService("User-Instance2");

        new OrderService("Order-Instance1");
        new OrderService("Order-Instance2");

        ApiGateway gateway = new ApiGateway();

        // Multiple requests to show load balancing
        for (int i = 1; i <= 5; i++) {
            String response = gateway.handleRequest("/order/1/Laptop");
            System.out.println("Response " + i + ": " + response);
        }
    }
}
